{
  "name": "immunogen",
  "version": "0.1.0",
  "description": "Scans AI-built (\"vibe-coded\") web apps for launch-blocking problems coding agents quietly ship, and emits a 0-100 Ship Score.",
  "keywords": [
    "security",
    "scanner",
    "static-analysis",
    "secrets",
    "sast",
    "sarif",
    "supabase",
    "stripe",
    "nextjs",
    "mcp",
    "ai",
    "vibe-coding",
    "cli"
  ],
  "homepage": "https://github.com/Mocinjay/immunogen#readme",
  "bugs": {
    "url": "https://github.com/Mocinjay/immunogen/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mocinjay/immunogen.git"
  },
  "type": "module",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@10.34.4",
  "bin": {
    "immunogen": "./dist/immunogen.js"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE",
    "THIRD_PARTY_NOTICES.md",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "test:dist": "node tests/dist/dual-import.test.mjs && node tests/dist/dual-import.test.cjs && node tests/dist/skill-parity.test.mjs && node tests/dist/cli-symlink.test.mjs",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.104.2",
    "@babel/parser": "7.29.7",
    "@babel/traverse": "7.29.7",
    "@babel/types": "7.29.7",
    "commander": "15.0.0",
    "extract-zip": "2.0.1",
    "fast-glob": "3.3.3",
    "ignore": "7.0.5",
    "openai": "6.44.0",
    "picocolors": "1.1.1",
    "simple-git": "4.0.2"
  },
  "devDependencies": {
    "@types/babel__traverse": "7.28.0",
    "@types/node": "22.19.21",
    "@typescript-eslint/eslint-plugin": "8.61.1",
    "@typescript-eslint/parser": "8.61.1",
    "eslint": "9.39.4",
    "eslint-plugin-security": "4.0.1",
    "license-checker": "25.0.1",
    "tsup": "8.5.1",
    "tsx": "4.22.4",
    "typescript": "5.9.3",
    "vitest": "4.1.9"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
